# Server
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# PostgreSQL (local install). Replace YOUR_PASSWORD with the postgres user's password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/grant_platform?schema=public

# Redis (Upstash free tier: copy the "rediss://" URL from the Upstash console)
REDIS_URL=

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# AI (Anthropic console → API keys)
ANTHROPIC_API_KEY=

# File storage: "local" in development, "s3" in production
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Email: "console" in development, "resend" in production
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
