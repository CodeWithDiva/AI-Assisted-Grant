# Server
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# Sign-in attempts per minute per visitor. 10 in production; higher locally so `pnpm e2e` is not throttled.
AUTH_RATE_LIMIT_PER_MINUTE=10

# PostgreSQL (local install). Replace YOUR_PASSWORD with the postgres user's password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/grant_platform?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# AI provider. Free: "gemini" (key from https://aistudio.google.com/apikey, no card needed)
# or "groq" (https://console.groq.com/keys). Paid: "anthropic". Also "ollama" (local, free)
# and "openai-compatible" (any OpenAI-style API; set AI_BASE_URL and AI_MODEL).
AI_PROVIDER=gemini
AI_API_KEY=
# Optional: override the provider's default model (gemini-3.6-flash / openai/gpt-oss-120b)
AI_MODEL=
# Optional: comma-separated models to try when AI_MODEL is busy or out of free quota
# ("none" to turn off). Gemini and Groq have sensible defaults.
AI_FALLBACK_MODEL=
AI_BASE_URL=

# Only for AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# File storage: "local" in development; "database" for free hosting (no bucket needed);
# "s3" for AWS S3 / R2 / B2 when the files outgrow the database
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Only when STORAGE_DRIVER=s3. Works with AWS S3, Cloudflare R2, Backblaze B2 or MinIO.
# Leave the keys empty on AWS to use the server's IAM role instead.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Email: "console" in development; "brevo" free (300/day, https://app.brevo.com → SMTP & API → API keys);
# "resend" needs a verified domain
EMAIL_DRIVER=console
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=noreply@example.com

# Error reporting (sentry.io → project → Client keys). Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Lets the scheduled GitHub workflow run the daily reminders (any long random string).
CRON_SECRET=
