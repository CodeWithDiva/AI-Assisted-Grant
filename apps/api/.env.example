# Server
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# PostgreSQL (local install). Replace YOUR_PASSWORD with the postgres user's password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/grant_platform?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# AI (Anthropic console → API keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# File storage: "local" in development, "s3" in production
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Only when STORAGE_DRIVER=s3. Works with AWS S3, Cloudflare R2, Backblaze B2 or MinIO.
# Leave the keys empty on AWS to use the server's IAM role instead.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Email: "console" in development, "resend" in production
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# Error reporting (sentry.io → project → Client keys). Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
